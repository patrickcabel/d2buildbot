# Bungie application credentials.
# Register an app at https://www.bungie.net/en/Application to obtain these.
# - OAuth Client Type: Confidential
# - Redirect URL must EXACTLY match BUNGIE_REDIRECT_URI below.
BUNGIE_API_KEY=your_api_key_here
BUNGIE_CLIENT_ID=your_oauth_client_id_here
BUNGIE_CLIENT_SECRET=your_oauth_client_secret_here
BUNGIE_REDIRECT_URI=http://localhost:8000/api/auth/callback

# Where the frontend runs (used for CORS + post-login redirect).
FRONTEND_ORIGIN=http://localhost:5173

# Optional: YouTube Data API v3 key, only needed to ingest video COMMENTS.
# Captions/transcripts work without it. Get one at https://console.cloud.google.com/
YOUTUBE_API_KEY=

# Fernet key used to encrypt stored OAuth tokens at rest.
# Leave blank to auto-generate one on first run (persisted to backend/.secret_key).
TOKEN_ENCRYPTION_KEY=
