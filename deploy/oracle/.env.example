# Copy to .env and fill in. Used by docker compose on the Oracle VM.
#
# PUBLIC URL (HTTPS). Easiest free option with your VM public IP:
#   If IP is 130.162.10.20 → DOMAIN=130-162-10-20.sslip.io
#   PUBLIC_BASE_URL=https://130-162-10-20.sslip.io
DOMAIN=YOUR-IP-WITH-DASHES.sslip.io
PUBLIC_BASE_URL=https://YOUR-IP-WITH-DASHES.sslip.io

BUNGIE_API_KEY=
BUNGIE_CLIENT_ID=
BUNGIE_CLIENT_SECRET=

# Optional
YOUTUBE_API_KEY=

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
